# Base de datos PostgreSQL (Vercel Postgres o Neon).
# Usa la misma base tanto en desarrollo local como en producción.

# Conexión con pool (la usa la app en tiempo de ejecución)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Conexión directa sin pgbouncer (la usa `prisma db push` / migraciones).
# Vercel Postgres la expone como DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require"

# Autenticación propia (sin servicio externo, ver src/lib/sesion.ts).
# Genera uno con: openssl rand -hex 32
SESSION_JWT_SECRET="cambia-esto-por-un-valor-aleatorio-largo"

# Contraseña temporal que se le da a cada cuenta nueva (debe cambiarla en
# su primer ingreso, ver src/app/cambiar-password).
PASSWORD_TEMPORAL_GENERICA="Radicado#Temporal2026"
