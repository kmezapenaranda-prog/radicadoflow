# Base de datos PostgreSQL (Vercel Postgres o Neon).
# Usa la misma base tanto en desarrollo local como en producción.

# Conexión con pool (la usa la app en tiempo de ejecución)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Conexión directa sin pgbouncer (la usa `prisma db push` / migraciones).
# Vercel Postgres la expone como DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require"

# Autenticación (Clerk) — provisionadas vía Vercel Marketplace o dashboard.clerk.com
CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Único correo autorizado para crear empresas nuevas (ver src/lib/tenant.ts)
NEXT_PUBLIC_ADMIN_EMAIL="admin@ejemplo.com"
