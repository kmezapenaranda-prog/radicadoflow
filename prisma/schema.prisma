// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Producción (Vercel Postgres / Neon). DATABASE_URL debe ser una cadena
  // de conexión postgresql:// (ver .env.example). Para desarrollo local,
  // usa la misma base Postgres (más simple que mantener dos motores).
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexión directa (sin pgbouncer) para `prisma db push`/migraciones.
  // Vercel Postgres la expone como DATABASE_URL_UNPOOLED.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Una empresa (tenant). Reemplaza a las Organizaciones de Clerk: el login y
// los roles ahora viven enteramente en esta base de datos (ver Usuario).
model Empresa {
  id        String    @id @default(cuid())
  nombre    String
  createdAt DateTime  @default(now())
  usuarios  Usuario[]
}

// Cuenta de acceso a la app. El "perfil" (admin/creador/registrador) se
// ignora si esSuperAdmin es true -- el super admin es el único que puede
// pertenecer/ver más de una empresa (empresaId queda null y usa
// empresaActivaId para saber cuál está viendo en este momento). Cualquier
// otra cuenta queda fija a una sola empresa desde que se crea.
model Usuario {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  nombre              String
  perfil              String    @default("registrador")
  esSuperAdmin        Boolean   @default(false)
  empresaId           String?
  empresa             Empresa?  @relation(fields: [empresaId], references: [id])
  empresaActivaId     String?
  debeCambiarPassword Boolean   @default(false)
  intentosFallidos    Int       @default(0)
  bloqueadoHasta      DateTime?
  createdAt           DateTime  @default(now())
}

// Una fila de configuración (turno de rotación) por empresa (tenant).
model Configuracion {
  empresaId   String   @id
  turnoActual Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// Una serie de consecutivos con su propio prefijo (CUEM, CUPE, UCI, ...).
// Cada serie lleva su propia numeración y detección de gaps, por empresa.
model Serie {
  id                Int        @id @default(autoincrement())
  empresaId         String
  codigo            String // "CUEM", "CUPE", "UCI"
  // Si es false, los radicados de esta serie se registran pero NO se
  // reparten a los trabajadores (ej: UCI se deja sin asignar).
  distribuible      Boolean    @default(true)
  consecutivoActual Int        @default(0)
  radicados         Radicado[]
  createdAt         DateTime   @default(now())

  @@unique([empresaId, codigo])
}

// Entidad (EPS/aseguradora) que remite el radicado. Se detecta desde la
// columna "Nombre Entidad" del Excel importado y también se puede elegir al
// registrar manualmente; sirve para llevar control de qué entidades llegan.
model Entidad {
  id        Int        @id @default(autoincrement())
  empresaId String
  nombre    String
  radicados Radicado[]
  createdAt DateTime   @default(now())

  @@unique([empresaId, nombre])
}

model Persona {
  id        Int        @id @default(autoincrement())
  empresaId String
  nombre    String
  email     String?
  orden     Int
  activo    Boolean    @default(true)
  radicados Radicado[]
  createdAt DateTime   @default(now())
}

model Radicado {
  id            Int      @id @default(autoincrement())
  empresaId     String
  serieId       Int
  serie         Serie    @relation(fields: [serieId], references: [id])
  numero        Int
  // Id de referencia del Excel de origen (columna "Id"), para trazabilidad.
  idExterno     Int?
  descripcion   String?
  personaId     Int?
  persona       Persona? @relation(fields: [personaId], references: [id])
  entidadId     Int?
  entidad       Entidad? @relation(fields: [entidadId], references: [id])
  esGap         Boolean  @default(false)
  creadoPor     String?
  fechaCreacion DateTime @default(now())
  mes           Int
  anio          Int

  @@unique([serieId, numero])
}
