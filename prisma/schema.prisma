// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Producción (Vercel Postgres / Neon). DATABASE_URL debe ser una cadena
  // de conexión postgresql:// (ver .env.example). Para desarrollo local,
  // usa la misma base Postgres (más simple que mantener dos motores).
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexión directa (sin pgbouncer) para `prisma db push`/migraciones.
  // Vercel Postgres la expone como DATABASE_URL_UNPOOLED.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Configuracion {
  id          Int      @id @default(1)
  turnoActual Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// Una serie de consecutivos con su propio prefijo (CUEM, CUPE, UCI, ...).
// Cada serie lleva su propia numeración y detección de gaps.
model Serie {
  id                Int        @id @default(autoincrement())
  codigo            String     @unique // "CUEM", "CUPE", "UCI"
  // Si es false, los radicados de esta serie se registran pero NO se
  // reparten a los trabajadores (ej: UCI se deja sin asignar).
  distribuible      Boolean    @default(true)
  consecutivoActual Int        @default(0)
  radicados         Radicado[]
  createdAt         DateTime   @default(now())
}

model Persona {
  id        Int        @id @default(autoincrement())
  nombre    String
  email     String?
  orden     Int
  activo    Boolean    @default(true)
  radicados Radicado[]
  createdAt DateTime   @default(now())
}

model Radicado {
  id            Int      @id @default(autoincrement())
  serieId       Int
  serie         Serie    @relation(fields: [serieId], references: [id])
  numero        Int
  // Id de referencia del Excel de origen (columna "Id"), para trazabilidad.
  idExterno     Int?
  descripcion   String?
  personaId     Int?
  persona       Persona? @relation(fields: [personaId], references: [id])
  esGap         Boolean  @default(false)
  creadoPor     String?
  fechaCreacion DateTime @default(now())
  mes           Int
  anio          Int

  @@unique([serieId, numero])
}
